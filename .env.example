# Copy to .env.local for local development. On Vercel, add these in
# Project Settings > Environment Variables. Never commit real values.

# --- Mode ---------------------------------------------------------------
# true = synthetic read-only demo (no database or accounts needed).
# Must be false in production.
DEMO_MODE=true

# --- Core ---------------------------------------------------------------
# Use your provider's POOLED connection string with TLS (e.g. Neon "-pooler" host, ?sslmode=require)
DATABASE_URL=postgresql://user:password@localhost:5432/clientflow
# Exact public HTTPS URL, no trailing slash (used for Twilio signatures and survey links)
APP_URL=http://localhost:3000
# 64 random hex characters: openssl rand -hex 32
AUTH_SECRET=
ADMIN_EMAIL=admin@example.com
# Generate with: npm run auth:hash -- "your long password"
ADMIN_PASSWORD_HASH=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to the scheduled worker
CRON_SECRET=
# IANA zone for daily charts, e.g. Australia/Sydney
BUSINESS_TIMEZONE=UTC
# Shown in SMS messages
BUSINESS_NAME=Coastal Clean Co.

# --- Branding (public, baked in at build time) --------------------------
NEXT_PUBLIC_BUSINESS_NAME=Coastal Clean Co.
NEXT_PUBLIC_CURRENCY=AUD
NEXT_PUBLIC_LOCALE=en-AU

# --- WordPress ------------------------------------------------------------
# Same value as CLIENTFLOW_WEBHOOK_SECRET in wp-config.php (32+ random characters)
WORDPRESS_WEBHOOK_SECRET=

# --- HubSpot --------------------------------------------------------------
# A HubSpot Service Key with crm.objects.contacts.read and .write scopes
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_VERSION=2026-09
# Optional: internal names of custom contact properties you created in HubSpot
HUBSPOT_PROPERTY_SERVICE=
HUBSPOT_PROPERTY_SOURCE=

# --- Twilio SMS -----------------------------------------------------------
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service (recommended) or a single sender number
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# --- BigQuery -------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=clientflow
BIGQUERY_TABLE=events
# Full service account JSON on one line (needs BigQuery Data Editor on the dataset + Job User on the project)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional separate salt for pseudonymous lead_ref values (defaults to AUTH_SECRET)
ANALYTICS_SALT=

# --- Tuning (optional) ----------------------------------------------------
PG_POOL_MAX=5
